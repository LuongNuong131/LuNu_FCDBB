# Runtime
NODE_ENV=development
PORT=3000

# Authentication
# Change this value before deploying.
JWT_SECRET=replace-with-a-long-random-secret

# Local development uses SQLite automatically when DATABASE_URL is empty.
SQLITE_DB_PATH=data/fcdbb.sqlite

# Optional PostgreSQL/Supabase connection for production.
# DATABASE_URL=postgresql://user:password@host:5432/database
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-service-role-or-storage-key

# Comma-separated frontend origins. Leave empty to allow local development origins.
CORS_ORIGINS=http://localhost:5173

# Set true only when you explicitly want TypeORM to synchronize a PostgreSQL schema.
TYPEORM_SYNCHRONIZE=false
